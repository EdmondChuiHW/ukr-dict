{
  "name": "ukdict",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "pipeline": "pnpm --filter @ukdict/pipeline run pipeline",
    "download": "pnpm --filter @ukdict/pipeline run pipeline --download-only",
    "sync-data": "node scripts/sync-data.ts",
    "web:dev": "pnpm --filter @ukdict/web run dev",
    "web:build": "pnpm --filter @ukdict/web run build",
    "web:preview": "pnpm --filter @ukdict/web run preview",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test"
  }
}
