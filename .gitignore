# Dependencies
node_modules/

# Build output
packages/web/dist/
*.tsbuildinfo
test-results/
playwright-report/

# Source dumps — downloaded per README (Ukrainian ~300 MB, English ~3.3 GB; GitHub rejects files > 100 MB)
data/kaikki-uk/
data/kaikki-en/

# Regenerable caches/logs (the lcorp response cache in data/cache/lcorp/ is kept: it takes ~1 h of rate-limited fetching to rebuild)
data/cache/en-translations-*.json.gz
data/cache/*.log
data/cache/*-log.jsonl

# Scratch scrapes (contain session cookies / response headers)
data/lcorp-probe/

# Misc
*.log
.DS_Store
.env
.env.*
